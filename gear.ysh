# This is a "gear". It's run by the oily-ci. it defines a CI job
# Highly experimental
# ysh 0.24.0

task "Say Hello" {
  var image = "quay.io/chroot.club/oils:v0.22.0-debian"
  var shell = :|osh -c|

  script {
    echo Hello World > myfile
  }
}

task "Say Goodbye" {
  var image = "quay.io/chroot.club/oils:v0.22.0-debian"
  var shell = :|osh -c|
  # TODO: inheritance? or what?
  script { cat myfile }
}
