#!/usr/bin/env ysh

# Weird name, provides 'log' and 'die'
#source --builtin osh/two.sh

if (len(ARGV) < 1) {
  echo Need at least one argument to run a file
  exit 1
}
proc info {
  echo '    ##' @[ARGV]
}

proc script (;;...args;block) {
  ctx emit script ([block, args]) 
}

func bindMount (src, dst) {
  return (:|--mount "type=bind,source=./,target=/$(basename $(pwd))"|)
}

func podman (image, cmd, extraArgs) {
    podman run -ti --rm @env @extraArgs $image $cmd
}

proc task (name;;;block) {
  var evals = {}
  ctx push (evals) {
    var taskinfo = io->eval(block, to_dict=true)
  }
  # TODO: merge dicts
  setvar taskinfo.script = evals.script[0]
  ctx emit $name (taskinfo)
}

case (ARGV[0]) {
  # If we have a YSH file, parse that
  # TODO: Oils sandboxed is still pending. That here should be sandboxed!
  *ysh {
    var code = $(cat $[ARGV[0]])
    var block = parseCommand(code)
    var tasks = {}
    ctx push (tasks) {
      call io->eval(block)
    }
  }
  (else) {
    info "Need a ysh file"
    exit 1
  }
}

# Important: The whole part from here on could be written in any language
# The idea is NOT to have a CI *written in ysh*.
# The idea is to have a CI *configured in hay*.
# not yaml + go templates. or yaml + jinja. or yaml + weird custom interpretation
# In most cases, you have *one* language

proc run-task (name; task, env_override) {
  info Run task: $name
# TODO: temporary fix for only one allowed script
  for script in ([task.script]) {
    var env = []
    for variable, info in (script[1]) {
# If a override is specified, use it
    if (variable in env_override) {
      setvar env = env ++ :|--env $variable=$[env_override[variable]]|
# Otherwise use default
    } else {
      setvar env = env ++ :|--env $variable=$info|
    }
  }
# @[podman(task.image, :| @[task=>get('shell', :|osh -c|)] $[script[0]] |, |@[bindMount("./", $(basename $(pwd)))] --init-path=/$(basename $(pwd))|]
  ysh strace_json.ysh $name osh <<<$[script[0].sourceCode().code_str] | json read (&f)
  setvar task.files = f
  }
}

for name, t in (tasks) {
  setvar task = t[0]
  #if (task.stage !== stage) { continue }
  
  #info "run stage: $stage"
  var environment = {}
  #if ("environment" in pipeline) {
  #  setvar environment = pipeline.environment
  #}
  run-task $name (task, environment)
}

= tasks
